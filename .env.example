# Copy to .env and fill in before running `docker compose up`.

DB_NAME=paissa
DB_USER=paissa
DB_PASSWORD=paissa

# Required: bearer key for POST /api/refresh (send as the X-Refresh-Key header).
REFRESH_KEY=changeme

# Origins allowed to call the API directly (only matters if you hit the backend outside the
# frontend's nginx proxy, e.g. during local `vite dev`).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

BACKEND_PORT=8080
FRONTEND_PORT=3000
POSTGRES_PORT=5432
